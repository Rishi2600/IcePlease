# Copy to .env and fill in real values. Never commit .env.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
# `docker compose up -d` starts a matching local database on port 5433.
DATABASE_URL="postgresql://iceplease:iceplease@localhost:5433/iceplease?schema=public"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Site ------------------------------------------------------------------

# Absolute site URL, used for metadata and Open Graph canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Business settings -----------------------------------------------------
# All money is in paise (minor units). 4900 = Rs 49.00

# Flat delivery fee applied at checkout.
DELIVERY_FEE_MINOR="4900"
# Order subtotal at or above which delivery is free. Empty = never free.
FREE_DELIVERY_THRESHOLD_MINOR="99900"
# Maximum units of a single product per order.
MAX_QUANTITY_PER_ITEM="20"

# --- Contact details -------------------------------------------------------
# Leave blank if not yet real. Blank values are hidden in the UI rather than
# rendered as a placeholder that looks like a working contact channel.

NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
# Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_SERVICE_AREA=""

# --- Local development seed ------------------------------------------------
# Used only by `npm run db:seed`. Never set these in production.

SEED_ADMIN_EMAIL="admin@iceplease.local"
SEED_ADMIN_PASSWORD="iceplease-dev"
