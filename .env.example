# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/iceplease?schema=public"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# GitHub OAuth app credentials (https://github.com/settings/developers).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public base URL used for metadata, canonical URLs and social sharing.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
